# Frontend
FRONTEND_EXTERNAL_PORT=3000
VITE_API_BASE_URL=

# Backend
BACKEND_EXTERNAL_PORT=8080
BACKEND_HOST=0.0.0.0
PHOTOS_DIR=/app/.photos
READ_TIMEOUT_IN_SEC=10s
WRITE_TIMEOUT_IN_SEC=10s
IDLE_TIMEOUT_IN_SEC=15s
SHUTDOWN_TIMEOUT_IN_SEC=3s

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT_UI=15672
RABBITMQ_PORT_AMQP=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PHOTO_QUEUE_NAME=processing_queue
RABBITMQ_RESPONSE_QUEUE_NAME=done_queue
RABBITMQ_PUBLISH_TIMEOUT_IS_SEC=30s

# Postgres
POSTGRES_HOST=postgres
POSTGRES_DB=evaluator
POSTGRES_USER=admin
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
