# Frontend
FRONTEND_EXTERNAL_PORT=3000

# Backend
BACKEND_EXTERNAL_PORT=8080
BACKEND_HOST=0.0.0.0
READ_TIMEOUT_IN_SEC=10s
WRITE_TIMEOUT_IN_SEC=10s
IDLE_TIMEOUT_IN_SEC=15s
SHUTDOWN_TIMEOUT_IN_SEC=3s

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT_UI=15672
RABBITMQ_PORT_AMQP=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PHOTO_QUEUE_NAME=photos_queue
RABBITMQ_PUBLISH_TIMEOUT_IS_SEC=30s

# Postgres
POSTGRES_HOST=postgres
POSTGRES_DB=evaluator
POSTGRES_USER=admin
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
